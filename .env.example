DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave POSTGRES_DB unset to use the local SQLite development database.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email / SMTP (never hardcode credentials in code) ---
# In development (DJANGO_DEBUG=True) emails print to the console by default.
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=JanSutra AI <no-reply@example.com>
EMAIL_SUBJECT_PREFIX=[JanSutra AI] 

# Absolute base URL used to build secure links inside emails.
SITE_BASE_URL=http://127.0.0.1:8000

# --- Account security ---
# Citizen accounts must confirm their email before signing in (set False for quick local demos).
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TIMEOUT=259200
PASSWORD_RESET_TIMEOUT=86400
OFFICER_TEMP_PASSWORD_BYTES=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Initial Administrator / District Collector (used by: python manage.py create_collector) ---
COLLECTOR_USERNAME=
COLLECTOR_EMAIL=
COLLECTOR_PASSWORD=

# --- AI Citizen Assistant (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
# Leave empty to fall back to the FAQ-only assistant (no external calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite
GEMINI_TIMEOUT=3
